# Importante – Este .env solo contendrá los secretos que son comunes a toda la instalación (credenciales de BD, clave secreta de JWT, etc.). Cada usuario tendrá su propio archivo cifrado (config_<userId>.json) que se tratará en la fase 2.
# ==== DATABASE ====
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=contaec_db
POSTGRES_USER=contaec_user
POSTGRES_PASSWORD=StrongDbPassword!2025   # ← cambiar por la real

# ==== JWT ====
SECRET_KEY=SuperSecretoJWT256Bits!CambiarEstoConUnValorAleatorioDe64Caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== Seguridad general ====
# Clave usada para cifrar los archivos de configuración por usuario (AES‑256‑GCM)
USER_CONFIG_ENC_KEY=OtroSecretoMuyLargoDe32Bytes!CambiarEsto

# ==== Rate limiting (slowapi) ====
# Número de requests permitidos por minuto por IP (ajustable)
RATE_LIMIT_PER_MINUTE=120

# ==== ClamAV (socket) ====
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310   # puerto default del daemon clamd

# ==== VirusTotal (opcional, se activa por usuario) ====
# VT_API_KEY=   # dejar vacío; se llenará por usuario en su config cifrada

# ==== Otros (puedes añadir más según necesidad) ====
ENVIRONMENT=production
LOG_LEVEL=info
